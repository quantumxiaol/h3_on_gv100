# ── 本机（mac）客户端 ─────────────────────────────────────
# 生图 API（OpenAI 兼容，参考 dsh-umamusume-agent 的 GENIMG_*）
GENIMG_API_BASE_URL=https://api.openai.com/v1
GENIMG_MODEL=gpt-image-2.5
GENIMG_API_KEY=

# GV100 上的 H3 API（内网穿透/公网地址填这里）
H3_API_BASE_URL=http://192.168.x.x:8010
H3_API_KEY=

# ── GV100 服务端（只在服务器上生效，h3-server 读取）─────────
H3_MODEL_PATH=modelsweights/MiniMax-H3
H3_DEVICE=cuda:0
H3_DIT_DTYPE=float16
H3_RESERVE=4GB
H3_HOST=0.0.0.0
H3_PORT=8010
H3_OUT_DIR=out/jobs
# H3_TURBO_LORA=              # M1：ModelTC Minimax-H3-Turbo 路径
